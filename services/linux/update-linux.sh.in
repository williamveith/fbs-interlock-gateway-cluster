#!/usr/bin/env bash
set -euo pipefail

APP="@APP@"
INSTALL_DIR="@INSTALL_DIR@"
STATE_DIR="/var/lib/${APP}"
DB_PATH="${STATE_DIR}/gateway.sqlite3"
DB_BACKUP="${STATE_DIR}/gateway.sqlite3.update-backup"
SERVICE_NAME="${APP}.service"
ADMIN_STATUS_URL="http://127.0.0.1:18090/api/status"
REPO="williamveith/fbs-interlock-gateway-cluster"

if [[ "$(id -u)" -ne 0 ]]; then
  if command -v pkexec >/dev/null 2>&1; then
    exec pkexec env \
      DISPLAY="${DISPLAY:-}" \
      XAUTHORITY="${XAUTHORITY:-}" \
      bash "$0" "$@"
  else
    echo "Administrator privileges are required."
    echo "Run this script with:"
    echo "  sudo ${INSTALL_DIR}/update.sh"
    exit 1
  fi
fi

command -v curl >/dev/null 2>&1 || {
  echo "ERROR: curl is required."
  exit 1
}

command -v sha256sum >/dev/null 2>&1 || {
  echo "ERROR: sha256sum is required."
  exit 1
}

wait_for_admin() {
  local attempt=0

  while [[ "$attempt" -lt 20 ]]; do
    if curl \
      --fail \
      --silent \
      --show-error \
      --max-time 2 \
      "$ADMIN_STATUS_URL" >/dev/null 2>&1; then
      return 0
    fi

    attempt=$((attempt + 1))
    sleep 1
  done

  return 1
}

restore_database() {
  rm -f "${DB_PATH}-journal" "${DB_PATH}-wal" "${DB_PATH}-shm"

  if [[ "$DB_WAS_PRESENT" -eq 1 ]]; then
    cp -a "$DB_BACKUP" "$DB_PATH"
  else
    rm -f "$DB_PATH"
  fi
}

rollback_update() {
  echo "Rolling back to the previous binary and configuration database..."

  systemctl stop "$SERVICE_NAME" >/dev/null 2>&1 || true

  install \
    -o root \
    -g root \
    -m 0755 \
    "$BACKUP" \
    "$CURRENT_BIN"

  restore_database

  if [[ "$WAS_ACTIVE" -eq 1 ]]; then
    systemctl start "$SERVICE_NAME" || true
  fi
}

case "$(uname -m)" in
  x86_64|amd64)
    ARCH="amd64"
    ;;
  aarch64|arm64)
    ARCH="arm64"
    ;;
  *)
    echo "ERROR: Unsupported architecture: $(uname -m)"
    exit 1
    ;;
esac

ASSET="${APP}-linux-${ARCH}"
BASE_URL="https://github.com/${REPO}/releases/latest/download"
BIN_URL="${BASE_URL}/${ASSET}"
SHA_URL="${BASE_URL}/${ASSET}.sha256"
SIG_URL="${BASE_URL}/${ASSET}.sha256.sig"

CURRENT_BIN="${INSTALL_DIR}/${APP}"

if [[ ! -d "$INSTALL_DIR" ]]; then
  echo "ERROR: Install directory does not exist:"
  echo "  $INSTALL_DIR"
  echo "Run install.sh first."
  exit 1
fi

if [[ ! -x "$CURRENT_BIN" ]]; then
  echo "ERROR: A trusted installed gateway binary is required:"
  echo "  $CURRENT_BIN"
  echo "Run install.sh or perform the one-time signed-update bootstrap first."
  exit 1
fi

TMP_DIR="$(mktemp -d)"
trap 'rm -rf "$TMP_DIR"' EXIT

echo "Checking latest release for ${APP}..."
echo "Architecture: linux-${ARCH}"
echo

# The hourly path downloads only the tiny checksum and its 64-byte Ed25519
# signature. The release binary itself is downloaded only when the authenticated
# release checksum differs from the installed binary.
echo "Downloading latest signed checksum..."
curl \
  --fail \
  --location \
  --retry 3 \
  --connect-timeout 10 \
  --proto '=https' \
  --tlsv1.2 \
  --output "${TMP_DIR}/${ASSET}.sha256" \
  "$SHA_URL" \
  --output "${TMP_DIR}/${ASSET}.sha256.sig" \
  "$SIG_URL"

echo "Verifying release checksum signature..."
VERIFY_ERROR="${TMP_DIR}/verify-update.err"

if ! EXPECTED_SHA="$(
  "$CURRENT_BIN" verify-update-checksum \
    --checksum "${TMP_DIR}/${ASSET}.sha256" \
    --signature "${TMP_DIR}/${ASSET}.sha256.sig" \
    --asset "$ASSET" \
    2>"$VERIFY_ERROR"
)"; then
  if [[ -s "$VERIFY_ERROR" ]]; then
    cat "$VERIFY_ERROR" >&2
  fi

  echo "ERROR: Release checksum signature verification failed."
  echo "No update will be downloaded or installed."
  exit 1
fi

EXPECTED_SHA="${EXPECTED_SHA,,}"

if [[ ! "$EXPECTED_SHA" =~ ^[0-9a-f]{64}$ ]]; then
  echo "ERROR: Trusted checksum verifier returned an invalid SHA-256 value."
  exit 1
fi

echo "Release checksum signature verified."

CURRENT_SHA="$(
  sha256sum "$CURRENT_BIN" |
    awk '{ print $1 }'
)"

CURRENT_SHA="${CURRENT_SHA,,}"

echo "Installed checksum: $CURRENT_SHA"
echo "Latest checksum:    $EXPECTED_SHA"

if [[ "$CURRENT_SHA" == "$EXPECTED_SHA" ]]; then
  echo "Already running the latest binary."
  exit 0
fi

echo "A newer or different authenticated binary is available."
echo
echo "Downloading latest binary..."

curl \
  --fail \
  --location \
  --retry 3 \
  --connect-timeout 10 \
  --proto '=https' \
  --tlsv1.2 \
  --output "${TMP_DIR}/${ASSET}" \
  "$BIN_URL"

echo "Verifying downloaded binary..."
DOWNLOADED_SHA="$(
  sha256sum "${TMP_DIR}/${ASSET}" |
    awk '{ print $1 }'
)"

DOWNLOADED_SHA="${DOWNLOADED_SHA,,}"

if [[ "$DOWNLOADED_SHA" != "$EXPECTED_SHA" ]]; then
  echo "ERROR: Downloaded binary checksum does not match the authenticated release checksum."
  echo "Expected: $EXPECTED_SHA"
  echo "Received: $DOWNLOADED_SHA"
  exit 1
fi

echo "Downloaded binary checksum verified."

chmod 0755 "${TMP_DIR}/${ASSET}"

extract_version() {
  "$1" -version 2>/dev/null |
    sed -n 's/.* version=\([^ ]*\).*/\1/p'
}

stable_semver_key() {
  local value="$1"

  if [[ ! "$value" =~ ^v([0-9]+)\.([0-9]+)\.([0-9]+)$ ]]; then
    return 1
  fi

  printf '%020d%020d%020d\n' \
    "$((10#${BASH_REMATCH[1]}))" \
    "$((10#${BASH_REMATCH[2]}))" \
    "$((10#${BASH_REMATCH[3]}))"
}

CURRENT_VERSION="$(extract_version "$CURRENT_BIN")"
CANDIDATE_VERSION="$(extract_version "${TMP_DIR}/${ASSET}")"

if [[ -z "$CURRENT_VERSION" || -z "$CANDIDATE_VERSION" ]]; then
  echo "ERROR: Could not read version metadata from the current or candidate binary."
  exit 1
fi

CURRENT_VERSION_KEY="$(stable_semver_key "$CURRENT_VERSION")" || {
  echo "ERROR: Installed version is not a stable semantic version: $CURRENT_VERSION"
  echo "Automatic updates require versions in the form vMAJOR.MINOR.PATCH."
  exit 1
}

CANDIDATE_VERSION_KEY="$(stable_semver_key "$CANDIDATE_VERSION")" || {
  echo "ERROR: Candidate version is not a stable semantic version: $CANDIDATE_VERSION"
  echo "Automatic updates require versions in the form vMAJOR.MINOR.PATCH."
  exit 1
}

echo "Installed version: $CURRENT_VERSION"
echo "Latest version:    $CANDIDATE_VERSION"

if [[ "$CANDIDATE_VERSION_KEY" < "$CURRENT_VERSION_KEY" ]]; then
  echo "ERROR: Refusing authenticated release downgrade."
  exit 1
fi

BACKUP="${INSTALL_DIR}/${APP}.backup.$(date -u +%Y%m%dT%H%M%SZ)"
WAS_ACTIVE=0
DB_WAS_PRESENT=0

if systemctl is-active --quiet "$SERVICE_NAME"; then
  WAS_ACTIVE=1
fi

echo "Stopping service..."
systemctl stop "$SERVICE_NAME"

echo "Backing up current binary:"
echo "  $BACKUP"
cp -a "$CURRENT_BIN" "$BACKUP"

rm -f "$DB_BACKUP"
if [[ -f "$DB_PATH" ]]; then
  echo "Backing up authoritative SQLite configuration:"
  echo "  $DB_BACKUP"
  cp -a "$DB_PATH" "$DB_BACKUP"
  DB_WAS_PRESENT=1
fi

echo "Installing latest binary..."
install \
  -o root \
  -g root \
  -m 0755 \
  "${TMP_DIR}/${ASSET}" \
  "$CURRENT_BIN"

# Verify that the installed binary is exactly the authenticated release binary.
INSTALLED_SHA="$(
  sha256sum "$CURRENT_BIN" |
    awk '{ print $1 }'
)"

INSTALLED_SHA="${INSTALLED_SHA,,}"

if [[ "$INSTALLED_SHA" != "$EXPECTED_SHA" ]]; then
  echo "ERROR: Installed binary checksum is incorrect."
  echo "Expected: $EXPECTED_SHA"
  echo "Received: $INSTALLED_SHA"
  rollback_update
  exit 1
fi

echo "Installed binary checksum verified."

if [[ "$WAS_ACTIVE" -eq 1 ]]; then
  echo "Starting service..."

  if ! systemctl start "$SERVICE_NAME"; then
    echo "ERROR: Service failed to start after update."
    rollback_update
    exit 1
  fi

  if ! wait_for_admin; then
    echo "ERROR: Admin API did not become ready after update."
    systemctl --no-pager --full status "$SERVICE_NAME" || true
    journalctl -u "$SERVICE_NAME" -n 100 --no-pager || true
    rollback_update
    exit 1
  fi

  if [[ ! -s "$DB_PATH" ]]; then
    echo "ERROR: SQLite configuration database is missing or empty after update:"
    echo "  $DB_PATH"
    rollback_update
    exit 1
  fi

  rm -f "$DB_BACKUP"
  echo "Update complete."
  systemctl --no-pager --full status "$SERVICE_NAME" || true
else
  rm -f "$DB_BACKUP"
  echo "Update complete."
  echo "Service was not active before the update, so it was not restarted."
fi
