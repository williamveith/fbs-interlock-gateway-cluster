#Requires -Version 5.1

[CmdletBinding()]
param()

Set-StrictMode -Version 2.0
$ErrorActionPreference = 'Stop'

$AppName = '@APP@'
$TaskName = 'FBS Interlock Gateway'
$InstallDirectory = [IO.Path]::GetFullPath('@WINDOWS_INSTALL_DIR@')
$DatabasePath = [IO.Path]::GetFullPath('@WINDOWS_DB_PATH@')
$LogDirectory = [IO.Path]::GetFullPath('@WINDOWS_LOG_DIR@')
$AdminStatusUrl = 'http://127.0.0.1:18090/api/status'

$Repository = 'williamveith/fbs-interlock-gateway-cluster'
$AssetName = "$AppName-windows-amd64.exe"
$BaseUrl = "https://github.com/$Repository/releases/latest/download"
$BinaryUrl = "$BaseUrl/$AssetName"
$ChecksumUrl = "$BaseUrl/$AssetName.sha256"
$SignatureUrl = "$BaseUrl/$AssetName.sha256.sig"

$CurrentBinary = Join-Path $InstallDirectory "$AppName.exe"
$LockDirectory = Join-Path $InstallDirectory '.update-lock'

$MaximumLogBytes = 10MB
$LogArchiveCount = 30

# Windows PowerShell 5.1 may otherwise inherit an older .NET TLS default.
[Net.ServicePointManager]::SecurityProtocol = [Net.SecurityProtocolType]::Tls12

function Assert-Administrator {
    $identity = [Security.Principal.WindowsIdentity]::GetCurrent()
    $principal = [Security.Principal.WindowsPrincipal]::new($identity)

    if (-not $principal.IsInRole(
        [Security.Principal.WindowsBuiltInRole]::Administrator
    )) {
        throw 'Administrator privileges are required to update the gateway.'
    }
}

function Get-PeMachine {
    param([Parameter(Mandatory)][string]$Path)

    $reader = $null
    $stream = [IO.File]::Open(
        $Path,
        [IO.FileMode]::Open,
        [IO.FileAccess]::Read,
        [IO.FileShare]::Read
    )

    try {
        $reader = [IO.BinaryReader]::new($stream)

        if ($reader.ReadUInt16() -ne 0x5A4D) {
            throw "The file is not a Windows PE executable: $Path"
        }

        $stream.Position = 0x3C
        $peOffset = $reader.ReadInt32()
        $stream.Position = $peOffset

        if ($reader.ReadUInt32() -ne 0x00004550) {
            throw "The file has an invalid PE signature: $Path"
        }

        return $reader.ReadUInt16()
    }
    finally {
        if ($null -ne $reader) {
            $reader.Dispose()
        }
        $stream.Dispose()
    }
}

function Assert-Amd64Binary {
    param([Parameter(Mandatory)][string]$Path)

    $machine = Get-PeMachine -Path $Path
    if ($machine -ne 0x8664) {
        throw ('The downloaded executable is not amd64. PE machine: 0x{0:X4}' -f $machine)
    }
}

function Get-Sha256 {
    param([Parameter(Mandatory)][string]$Path)

    return (Get-FileHash -LiteralPath $Path -Algorithm SHA256).Hash.ToLowerInvariant()
}

function Invoke-Download {
    param(
        [Parameter(Mandatory)][string]$Uri,
        [Parameter(Mandatory)][string]$OutFile
    )

    $lastError = $null

    for ($attempt = 1; $attempt -le 3; $attempt++) {
        try {
            Invoke-WebRequest `
                -Uri $Uri `
                -OutFile $OutFile `
                -UseBasicParsing `
                -TimeoutSec 60
            return
        }
        catch {
            $lastError = $_

            if ($attempt -lt 3) {
                Start-Sleep -Seconds $attempt
            }
        }
    }

    throw $lastError
}

function Get-AuthenticatedReleaseSha {
    param(
        [Parameter(Mandatory)][string]$ChecksumPath,
        [Parameter(Mandatory)][string]$SignaturePath,
        [Parameter(Mandatory)][string]$ExpectedAsset,
        [Parameter(Mandatory)][string]$ErrorPath
    )

    $output = & $CurrentBinary `
        verify-update-checksum `
        --checksum $ChecksumPath `
        --signature $SignaturePath `
        --asset $ExpectedAsset `
        2> $ErrorPath

    $exitCode = $LASTEXITCODE

    if ($exitCode -ne 0) {
        if (Test-Path -LiteralPath $ErrorPath -PathType Leaf) {
            $details = (Get-Content -LiteralPath $ErrorPath -Raw).Trim()
            if ($details) {
                [Console]::Error.WriteLine($details)
            }
        }

        throw "Release checksum signature verification failed with exit code $exitCode."
    }

    $sha = (($output | Out-String).Trim()).ToLowerInvariant()

    if ($sha -notmatch '^[0-9a-f]{64}$') {
        throw 'Trusted checksum verifier returned an invalid SHA-256 value.'
    }

    return $sha
}

function Get-GatewayVersion {
    param([Parameter(Mandatory)][string]$Path)

    $versionOutput = & $Path -version 2>&1
    if ($LASTEXITCODE -ne 0) {
        throw "Gateway version check failed for $Path with exit code $LASTEXITCODE."
    }

    $versionText = ($versionOutput | Out-String).Trim()
    $match = [regex]::Match($versionText, '(?:^|\s)version=(v[^\s]+)')

    if (-not $match.Success) {
        throw "Could not read gateway version metadata from: $Path"
    }

    return $match.Groups[1].Value
}

function ConvertTo-StableSemVerParts {
    param([Parameter(Mandatory)][string]$Value)

    $match = [regex]::Match($Value, '^v([0-9]+)\.([0-9]+)\.([0-9]+)$')
    if (-not $match.Success) {
        throw "Automatic updates require a stable semantic version in the form vMAJOR.MINOR.PATCH: $Value"
    }

    try {
        return @(
            [UInt64]::Parse($match.Groups[1].Value),
            [UInt64]::Parse($match.Groups[2].Value),
            [UInt64]::Parse($match.Groups[3].Value)
        )
    }
    catch {
        throw "Semantic version component is too large: $Value"
    }
}

function Assert-NotDowngrade {
    param(
        [Parameter(Mandatory)][string]$CurrentVersion,
        [Parameter(Mandatory)][string]$CandidateVersion
    )

    $current = ConvertTo-StableSemVerParts -Value $CurrentVersion
    $candidate = ConvertTo-StableSemVerParts -Value $CandidateVersion

    for ($index = 0; $index -lt 3; $index++) {
        if ($candidate[$index] -lt $current[$index]) {
            throw "Refusing authenticated release downgrade from $CurrentVersion to $CandidateVersion."
        }

        if ($candidate[$index] -gt $current[$index]) {
            return
        }
    }

    # Equal versions are allowed so an authenticated release can repair a
    # corrupted or otherwise different installed binary.
}

function Test-LogNeedsRotation {
    param([Parameter(Mandatory)][string]$Path)

    if (-not (Test-Path -LiteralPath $Path -PathType Leaf)) {
        return $false
    }

    return ((Get-Item -LiteralPath $Path).Length -ge $MaximumLogBytes)
}

function Rotate-Log {
    param([Parameter(Mandatory)][string]$Path)

    $oldestArchive = "$Path.$LogArchiveCount.zip"
    Remove-Item -LiteralPath $oldestArchive -Force -ErrorAction SilentlyContinue

    for ($index = $LogArchiveCount - 1; $index -ge 1; $index--) {
        $sourceArchive = "$Path.$index.zip"
        $destinationArchive = "$Path.$($index + 1).zip"

        if (Test-Path -LiteralPath $sourceArchive -PathType Leaf) {
            Move-Item `
                -LiteralPath $sourceArchive `
                -Destination $destinationArchive `
                -Force
        }
    }

    if (Test-Path -LiteralPath $Path -PathType Leaf) {
        $stagedLog = "$Path.1"
        Move-Item -LiteralPath $Path -Destination $stagedLog -Force
        Compress-Archive `
            -LiteralPath $stagedLog `
            -DestinationPath "$Path.1.zip" `
            -CompressionLevel Optimal `
            -Force
        Remove-Item -LiteralPath $stagedLog -Force
    }

    New-Item -ItemType File -Path $Path -Force | Out-Null
}

function Test-GatewayTaskRegistered {
    return ($null -ne (
        Get-ScheduledTask -TaskName $TaskName -ErrorAction SilentlyContinue
    ))
}

function Stop-Gateway {
    Stop-ScheduledTask -TaskName $TaskName -ErrorAction SilentlyContinue

    Get-Process -Name $AppName -ErrorAction SilentlyContinue |
        Stop-Process -Force -ErrorAction SilentlyContinue

    Start-Sleep -Seconds 1
}

function Start-Gateway {
    Start-ScheduledTask -TaskName $TaskName
}

function Wait-ForAdminApi {
    for ($attempt = 1; $attempt -le 20; $attempt++) {
        try {
            $response = Invoke-WebRequest `
                -Uri $AdminStatusUrl `
                -UseBasicParsing `
                -TimeoutSec 2

            if ($response.StatusCode -ge 200 -and $response.StatusCode -lt 300) {
                return $true
            }
        }
        catch {
            Start-Sleep -Seconds 1
        }
    }

    return $false
}

function Test-DatabaseReady {
    if (-not (Test-Path -LiteralPath $DatabasePath -PathType Leaf)) {
        return $false
    }

    return ((Get-Item -LiteralPath $DatabasePath).Length -gt 0)
}

function Backup-Database {
    param([Parameter(Mandatory)][string]$BackupPath)

    if (Test-Path -LiteralPath $DatabasePath -PathType Leaf) {
        Copy-Item -LiteralPath $DatabasePath -Destination $BackupPath -Force
        return $true
    }

    return $false
}

function Restore-Database {
    param(
        [Parameter(Mandatory)][string]$BackupPath,
        [Parameter(Mandatory)][bool]$DatabaseExisted,
        [Security.AccessControl.FileSecurity]$OriginalAcl
    )

    Remove-Item -LiteralPath "$DatabasePath-journal" -Force -ErrorAction SilentlyContinue
    Remove-Item -LiteralPath "$DatabasePath-wal" -Force -ErrorAction SilentlyContinue
    Remove-Item -LiteralPath "$DatabasePath-shm" -Force -ErrorAction SilentlyContinue

    if ($DatabaseExisted) {
        Copy-Item -LiteralPath $BackupPath -Destination $DatabasePath -Force
        if ($null -ne $OriginalAcl) {
            Set-Acl -LiteralPath $DatabasePath -AclObject $OriginalAcl
        }
    }
    else {
        Remove-Item -LiteralPath $DatabasePath -Force -ErrorAction SilentlyContinue
    }
}

Assert-Administrator

if (-not (Test-Path -LiteralPath $InstallDirectory -PathType Container)) {
    throw "Install directory does not exist: $InstallDirectory"
}

if (-not (Test-Path -LiteralPath $CurrentBinary -PathType Leaf)) {
    throw @"
A trusted installed gateway executable is required:
$CurrentBinary
Run install.bat or perform the one-time signed-update bootstrap first.
"@
}

if (Test-Path -LiteralPath $LockDirectory -PathType Container) {
    $lockAge = [DateTime]::UtcNow - (Get-Item -LiteralPath $LockDirectory).LastWriteTimeUtc

    if ($lockAge.TotalHours -ge 2) {
        Remove-Item -LiteralPath $LockDirectory -Recurse -Force
    }
}

try {
    New-Item -ItemType Directory -Path $LockDirectory -ErrorAction Stop | Out-Null
}
catch {
    Write-Host 'Another update or maintenance operation is already running; exiting.'
    exit 0
}

$tempDirectory = Join-Path $env:TEMP (
    '{0}-update-{1}' -f $AppName, [Guid]::NewGuid().ToString('N')
)
New-Item -ItemType Directory -Path $tempDirectory -Force | Out-Null

try {
    Write-Host "Checking the latest release for $AppName..."
    Write-Host 'Architecture: windows-amd64'

    # The scheduled hourly path downloads only the tiny checksum and its
    # 64-byte Ed25519 signature. The executable itself is downloaded only when
    # the authenticated release checksum differs from the installed executable.
    $checksumPath = Join-Path $tempDirectory "$AssetName.sha256"
    $signaturePath = Join-Path $tempDirectory "$AssetName.sha256.sig"
    $verifyErrorPath = Join-Path $tempDirectory 'verify-update.err'

    Write-Host 'Downloading the latest signed checksum...'
    Invoke-Download -Uri $ChecksumUrl -OutFile $checksumPath
    Invoke-Download -Uri $SignatureUrl -OutFile $signaturePath

    Write-Host 'Verifying release checksum signature...'
    $expectedSha = Get-AuthenticatedReleaseSha `
        -ChecksumPath $checksumPath `
        -SignaturePath $signaturePath `
        -ExpectedAsset $AssetName `
        -ErrorPath $verifyErrorPath

    Write-Host 'Release checksum signature verified.'

    $currentSha = Get-Sha256 -Path $CurrentBinary
    Write-Host "Installed checksum: $currentSha"
    Write-Host "Latest checksum:    $expectedSha"

    $updateRequired = ($currentSha -ne $expectedSha)

    $gatewayLog = Join-Path $LogDirectory 'gateway.log'
    $gatewayErrorLog = Join-Path $LogDirectory 'gateway-error.log'
    $rotateGatewayLog = Test-LogNeedsRotation -Path $gatewayLog
    $rotateGatewayErrorLog = Test-LogNeedsRotation -Path $gatewayErrorLog

    if (-not $updateRequired -and
        -not $rotateGatewayLog -and
        -not $rotateGatewayErrorLog) {
        Write-Host 'Already running the latest authenticated binary; logs are within limits.'
        exit 0
    }

    $downloadPath = Join-Path $tempDirectory $AssetName

    if ($updateRequired) {
        Write-Host 'A newer or different authenticated executable is available.'
        Write-Host 'Downloading the latest executable...'
        Invoke-Download -Uri $BinaryUrl -OutFile $downloadPath

        Write-Host 'Verifying downloaded executable...'
        $downloadedSha = Get-Sha256 -Path $downloadPath

        if ($downloadedSha -ne $expectedSha) {
            throw @"
Downloaded executable checksum does not match the authenticated release checksum.
Expected: $expectedSha
Received: $downloadedSha
"@
        }

        Write-Host 'Downloaded executable checksum verified.'

        Assert-Amd64Binary -Path $downloadPath

        $currentVersion = Get-GatewayVersion -Path $CurrentBinary
        $candidateVersion = Get-GatewayVersion -Path $downloadPath

        Write-Host "Installed version: $currentVersion"
        Write-Host "Latest version:    $candidateVersion"

        Assert-NotDowngrade `
            -CurrentVersion $currentVersion `
            -CandidateVersion $candidateVersion
    }

    $taskRegistered = Test-GatewayTaskRegistered
    $backupPath = $null
    $databaseBackupPath = Join-Path $tempDirectory 'gateway.sqlite3.backup'
    $databaseExisted = Test-Path -LiteralPath $DatabasePath -PathType Leaf
    $databaseAcl = $null
    if ($databaseExisted) {
        $databaseAcl = Get-Acl -LiteralPath $DatabasePath
    }
    $existingAcl = Get-Acl -LiteralPath $CurrentBinary

    if ($updateRequired) {
        $timestamp = [DateTime]::UtcNow.ToString('yyyyMMddTHHmmssZ')
        $backupPath = Join-Path $InstallDirectory "$AppName.exe.backup.$timestamp"
        Write-Host "Backing up the current executable: $backupPath"
        Copy-Item -LiteralPath $CurrentBinary -Destination $backupPath -Force
    }

    if ($taskRegistered) {
        Write-Host 'Stopping the gateway...'
        Stop-Gateway
    }

    if ($updateRequired) {
        Write-Host 'Backing up the authoritative SQLite database...'
        [void](Backup-Database -BackupPath $databaseBackupPath)
    }

    if ($rotateGatewayLog) {
        Write-Host 'Rotating gateway.log...'
        Rotate-Log -Path $gatewayLog
    }

    if ($rotateGatewayErrorLog) {
        Write-Host 'Rotating gateway-error.log...'
        Rotate-Log -Path $gatewayErrorLog
    }

    if ($updateRequired) {
        Write-Host 'Installing the latest executable...'
        $stagedPath = "$CurrentBinary.new"
        Copy-Item -LiteralPath $downloadPath -Destination $stagedPath -Force

        $stagedSha = Get-Sha256 -Path $stagedPath
        if ($stagedSha -ne $expectedSha) {
            Remove-Item -LiteralPath $stagedPath -Force -ErrorAction SilentlyContinue

            if ($taskRegistered) {
                Start-Gateway
            }

            throw @"
The staged executable checksum is incorrect.
Expected: $expectedSha
Received: $stagedSha
"@
        }

        [IO.File]::Replace($stagedPath, $CurrentBinary, $null, $true)
        Set-Acl -LiteralPath $CurrentBinary -AclObject $existingAcl

        $installedSha = Get-Sha256 -Path $CurrentBinary
        if ($installedSha -ne $expectedSha) {
            Write-Warning 'The installed executable checksum is incorrect.'

            if ($backupPath -and (Test-Path -LiteralPath $backupPath -PathType Leaf)) {
                Write-Warning 'Rolling back to the previous executable.'
                Copy-Item -LiteralPath $backupPath -Destination $CurrentBinary -Force
                Set-Acl -LiteralPath $CurrentBinary -AclObject $existingAcl
            }

            if ($taskRegistered) {
                Start-Gateway
            }

            throw @"
Installed executable checksum mismatch.
Expected: $expectedSha
Received: $installedSha
"@
        }

        Write-Host 'Installed executable checksum verified.'
    }

    if ($taskRegistered) {
        Write-Host 'Starting the gateway...'
        Start-Gateway

        $adminReady = Wait-ForAdminApi
        $databaseReady = Test-DatabaseReady

        if (-not $adminReady -or -not $databaseReady) {
            Write-Warning 'The gateway failed its post-update health/database check.'
            Stop-Gateway

            if ($backupPath -and (Test-Path -LiteralPath $backupPath -PathType Leaf)) {
                Write-Warning 'Rolling back to the previous executable and SQLite database.'
                Copy-Item -LiteralPath $backupPath -Destination $CurrentBinary -Force
                Set-Acl -LiteralPath $CurrentBinary -AclObject $existingAcl
                Restore-Database `
                    -BackupPath $databaseBackupPath `
                    -DatabaseExisted $databaseExisted `
                    -OriginalAcl $databaseAcl
            }

            Start-Gateway
            [void](Wait-ForAdminApi)
            throw 'The update was rolled back because the Admin API did not become ready.'
        }
    }

    if ($updateRequired) {
        Write-Host 'Update complete.'
    }
    else {
        Write-Host 'Log maintenance complete; the executable was unchanged.'
    }

    if (-not $taskRegistered) {
        Write-Host 'The gateway task was not registered, so it was not started.'
    }
}
finally {
    Remove-Item -LiteralPath $tempDirectory -Recurse -Force -ErrorAction SilentlyContinue
    Remove-Item -LiteralPath $LockDirectory -Recurse -Force -ErrorAction SilentlyContinue
}
